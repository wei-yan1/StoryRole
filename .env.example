# 阿里云 MaaS（当前唯一语言模型入口，使用 OpenAI 兼容协议）
# deepseek-v4.1-flash-1017 是阿里云上的模型 ID，由阿里云转发。
# 女娲、证据分析、角色判断、Review、RoleRAG 全部走这里；禁止按 deepseek- 前缀切换到官方 API。
DASHSCOPE_API_KEY=your_dashscope_api_key
# DeepSeek 官方 API（仅回滚备用，当前项目禁止自动使用）
# 不要因为模型名含 deepseek 就启用下面两个变量；当前模型必须走上方阿里云 MaaS。
# DEEPSEEK_API_KEY=your_official_deepseek_key_for_rollback_only
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_* 在这里表示阿里云 MaaS 的 OpenAI 兼容配置，不是 OpenAI 官方，也不是 DeepSeek 官方。
# 当前模型 ID 固定为 deepseek-v4.1-flash-1017；deepseek-flash 会返回 404。
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_DOCUMENT_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_QUERY_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank
# Embedding backend: dashscope or ollama. Ollama keeps document/query text local.
EMBEDDING_PROVIDER=dashscope
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional version string. Change it when the local model weights change.
OLLAMA_EMBEDDING_MODEL_VERSION=
# Optional version string for remote embedding model revisions.
DASHSCOPE_EMBEDDING_MODEL_VERSION=
TAVILY_API_KEY=your_optional_tavily_api_key_for_transparent_mode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=three_body_agent
# Optional: use a full connection string instead of POSTGRES_* variables.
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/three_body_agent
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CHAT_MEMORY_TTL_SECONDS=43200
CHAT_MEMORY_MAX_MESSAGES=20
EPISODIC_MEMORY_CAPACITY=40
EPISODIC_FORGET_THRESHOLD=0.4
EPISODIC_RECALL_BOOST=0.05
EPISODIC_MAX_IMPORTANCE=0.95
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
TEST_CHAT_MODEL=deepseek-v4.1-flash-1017
PROD_CHAT_MODEL=deepseek-v4.1-flash-1017
ROUTER_MODEL=deepseek-v4.1-flash-1017
# Router defaults to DASHSCOPE_API_KEY and DASHSCOPE_BASE_URL.
# ROUTER_API_KEY=optional_different_router_key
# ROUTER_BASE_URL=optional_different_router_base_url
DEFAULT_CHAT_MODEL=deepseek-v4.1-flash-1017
REWRITE_CHAT_MODEL=deepseek-v4.1-flash-1017

# Import-time indexing: parse -> chunk -> embedding -> Chroma + persistent BM25
STORYROLE_AUTO_INDEX=1
STORYROLE_CHROMA_DIR=data/indexes/chroma
STORYROLE_INDEX_COLLECTION_PREFIX=storyrole_novel_
STORYROLE_EMBED_BATCH_SIZE=40
STORYROLE_EMBED_WORKERS=5
STORYROLE_EMBED_MAX_RETRIES=5
STORYROLE_EMBED_RATE_PER_SECOND=0

# StoryRole A2A transport: local keeps agents in-process; http enables remote agents.
STORYROLE_A2A_TRANSPORT=local
STORYROLE_A2A_BASE_URL=http://127.0.0.1:1314
STORYROLE_A2A_TIMEOUT=60
# Optional shared secret for remote A2A service-to-service calls.
# STORYROLE_A2A_SHARED_SECRET=change-me
STORYROLE_NUWA_MODEL=deepseek-v4.1-flash-1017
STORYROLE_CHAT_MODEL=deepseek-v4.1-flash-1017
# Optional per-agent remote URLs:
# STORYROLE_A2A_URL_CHARACTER_RESOLVER=http://resolver:8000
# STORYROLE_A2A_URL_NUWA_PROFILER=http://nuwa:8000
# STORYROLE_A2A_URL_CHARACTER_CONVERSATION=http://conversation:8000

STORYROLE_REASONING_MODEL=deepseek-v4.1-flash-1017
STORYROLE_GUARD_MODEL=deepseek-v4.1-flash-1017
STORYROLE_GUARD_ENABLED=1

# laya (default, active with rule fallback), laya_shadow (compare only), or rule
STORYROLE_DECISION_BACKEND=laya
STORYROLE_LAYA_MODEL=convaiinnovations/laya-multilingual
STORYROLE_LAYA_DEVICE=auto

# Provider/model pricing per one million tokens. Values use the provider's billing currency.
# Keep this in sync with the provider pricing page; unknown remote prices are shown as "未配置".
# cached_input_per_million is optional and applies to cached prompt tokens.
MODEL_PRICING_JSON={"deepseek":{"deepseek-chat":{"input_per_million":2,"cached_input_per_million":0.2,"output_per_million":8},"deepseek-reasoner":{"input_per_million":4,"cached_input_per_million":1,"output_per_million":16},"deepseek-flash":{"input_per_million":2,"cached_input_per_million":0.2,"output_per_million":8}},"dashscope":{"deepseek-v4.1-flash-1017":{"input_per_million":2,"cached_input_per_million":0.2,"output_per_million":8},"qwen3.7-text-rerank":{"input_per_million":1,"output_per_million":0},"qwen3-rerank":{"input_per_million":1,"output_per_million":0}}}

# Optional non-LLM roles on the same gateway key (see docs/model-gateway.md).
# Chat roles stay on deepseek-v4.1-flash-1017; uncomment only to override.
# MODEL_EMBEDDING=qwen3.7-text-embedding
MODEL_IMAGE=qwen-image-3.0-pro
MODEL_ASR=fun-asr-flash-2026-06-15
MODEL_TTS=qwen3-tts-flash
MODEL_OMNI=qwen3.8-max
MODEL_TRANSLATE=qwen-mt-plus
MODEL_OCR=qwen3.5-ocr
# MODEL_IMAGE_FAST=wan2.7-image

# --- Alibaba Cloud OSS (image upload / read) ---
# Bucket 为“公共读”时，读取图片只需要 OSS_PUBLIC_BASE_URL，不需要 AccessKey；
# 只有通过代码上传/删除对象时才必须配置 OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET。
# AccessKey 在 https://ram.console.aliyun.com/manage/ak 创建，Secret 只显示一次。
OSS_REGION=cn-guangzhou
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=lbwnb111
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://lbwnb111.oss-cn-guangzhou.aliyuncs.com
OSS_IMAGE_PREFIX=images
OSS_MAX_IMAGE_BYTES=10485760
